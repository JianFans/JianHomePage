# 复制为服务工作目录下的 .env，完整说明见 docs/DEPLOYMENT.md。
# 以下均为格式示例；账号、密钥、项目 ID 和域名须替换为实际值。
# 值包含 $ 或 # 时用单引号包裹，避免插值或被识别为注释。

# 运行环境：production、development 或 test；正式部署保持 production。
APP_ENV=production
# 监听地址；本机反向代理使用此值，容器部署改为 0.0.0.0:8080。
HTTP_ADDRESS=127.0.0.1:8080
# 优雅停止超时，支持 10s、30s、1m 等 Go 时长格式。
SHUTDOWN_TIMEOUT=10s
# 日志级别：debug、info、warn 或 error；生产默认 info。
LOG_LEVEL=info
# 控制台格式：text 便于直接阅读，json 便于日志平台采集。
LOG_FORMAT=text
# 可选 JSONL 文件路径；留空时只写控制台。启用前创建父目录并授予服务账号写权限。
LOG_FILE=
# 日志文件达到此大小后轮转，单位 MB。
LOG_MAX_SIZE_MB=20
# 保留的轮转文件数；当前文件之外的备份不压缩。
LOG_MAX_BACKUPS=5
# 是否允许开发身份；生产环境必须为 false。
ALLOW_DEV_IDENTITY=false

# PostgreSQL：postgresql://用户名:密码@主机:端口/数据库名?sslmode=require。
# 替换下列账号、密码、地址和库名；require 要求 TLS，仅本机无 TLS 时改用 disable。
# 密码中的保留字符须 URL 编码，例如 p@ss#123 写为 p%40ss%23123。
DATABASE_URL='postgresql://yujian:replace-me@127.0.0.1:5432/yujian?sslmode=require'

# OIDC 签发者地址，与身份服务 discovery 文档中的 issuer 一致；下例以 Casdoor 为例。
OIDC_ISSUER=https://auth.example.com
# 本 API 的 access token audience，按身份服务配置填写；Casdoor 普通应用通常为 Client ID。
OIDC_AUDIENCE=0123456789abcdef0123
# 身份服务中对应本站权限的角色名；区分大小写，自定义值替换默认名，不支持空白或重复名称。
# 仅需匹配其中一个角色；令牌中的其他角色会忽略。下列默认值可直接保留。
# 内容编辑角色，例如身份服务使用 yujian-editor 时改为 OIDC_ROLE_EDITOR=yujian-editor。
OIDC_ROLE_EDITOR=editor
# 内容审核角色。
OIDC_ROLE_REVIEWER=reviewer
# 发布与回滚角色。
OIDC_ROLE_PUBLISHER=publisher
# 管理员角色。
OIDC_ROLE_ADMIN=admin
# 后台 OIDC 客户端 ID，从身份服务的客户端配置获取；下列值仅示意格式。
ADMIN_OIDC_CLIENT_ID=0123456789abcdef0123
# 客户端密钥，从同一客户端配置获取；public client 将此项留空。
ADMIN_OIDC_CLIENT_SECRET='replace-with-oidc-client-secret'
# 登录回调地址，必须同时注册到身份服务的回调白名单。
ADMIN_OIDC_REDIRECT_URL=https://admin.yujian.me/api/v1/auth/callback
# 登录完成后的后台地址，其 Origin 必须包含在下一项中。
ADMIN_RETURN_URL=https://admin.yujian.me/
# 允许的后台 Origin，不带路径或末尾 /；多项示例：https://admin.yujian.me,https://studio.example.com。
ADMIN_ALLOWED_ORIGINS=https://admin.yujian.me
# 会话密钥：32 字节随机值的标准 Base64；运行 openssl rand -base64 32 生成。
# 下列值仅展示格式，必须重新生成，不能用于正式部署。
ADMIN_SESSION_KEY='AAECAwQFBgcICQoLDA0ODxAREhMUFRYXGBkaGxwdHh8='

# COS 地域端点，不含桶名；其他 S3 兼容服务填写自身端点。
S3_ENDPOINT=https://cos.ap-singapore.myqcloud.com
# 桶所在地域，须与端点一致，从 COS 桶概览获取。
S3_REGION=ap-singapore
# COS 完整桶名，格式为桶名-APPID；仅用于媒体文件。
S3_BUCKET=yujian-assets-1250000000
# 腾讯云 CAM API 密钥中的 SecretId；下例为占位示例。
S3_ACCESS_KEY_ID=AKIDEXAMPLE_REPLACE_ME
# 同一对 CAM 凭据的 SecretKey，需有目标桶的访问权限。
S3_SECRET_ACCESS_KEY='replace-with-cam-secret-key'
# 使用长期 CAM 密钥时留空；使用 STS 时填写返回的 sessionToken，并配套临时密钥。
# 临时凭据示例：S3_SESSION_TOKEN='replace-with-sts-session-token'
S3_SESSION_TOKEN=
# COS 使用虚拟主机寻址，保持 false；其他 S3 服务按其要求设置。
S3_USE_PATH_STYLE=false
# 稳定的 HTTPS 素材访问地址，经 EdgeOne 回源 COS，不使用临时签名 URL。
MEDIA_PUBLIC_BASE_URL=https://media.yujian.me

# 在 EdgeOne Pages 控制台的 API Token 页面创建，不是 CAM SecretKey。
PAGES_API_TOKEN='replace-with-pages-api-token'
# Pages Direct Upload 项目的 ID，从项目详情复制，不是项目名称；下例仅示意格式。
PAGES_PROJECT_ID=project-example-123456
# API／账号所属站点：中国站控制台填 china，国际站控制台填 global，项目和 Token 须属于同一站点。
# china 使用 pages-api.cloud.tencent.com，global 使用 pages-api.edgeone.ai。
# 不是新建项目时选择的部署区域，也不是 COS 的地域；不要填写 ap-guangzhou 等值。
PAGES_REGION=global
# Pages 绑定的公开站地址，须与内容快照的 canonical URL 一致。
PAGES_PUBLIC_URL=https://yujian.me
