# Copy to .env in the server working directory. See docs/DEPLOYMENT.md.
# Single-quote values containing $ or # to preserve them literally.
APP_ENV=production
HTTP_ADDRESS=127.0.0.1:8080
SHUTDOWN_TIMEOUT=10s
ALLOW_DEV_IDENTITY=false

# PostgreSQL connection URL (percent-encode reserved password characters).
DATABASE_URL=

# OIDC provider and browser client. Secret is optional for public clients.
OIDC_ISSUER=
OIDC_AUDIENCE=
ADMIN_OIDC_CLIENT_ID=
ADMIN_OIDC_CLIENT_SECRET=
ADMIN_OIDC_REDIRECT_URL=https://admin.yujian.me/api/v1/auth/callback
ADMIN_RETURN_URL=https://admin.yujian.me/
ADMIN_ALLOWED_ORIGINS=https://admin.yujian.me
# Generate with: openssl rand -base64 32
ADMIN_SESSION_KEY=

# COS/S3-compatible object storage. Keep snapshots/* private.
S3_ENDPOINT=https://cos.ap-singapore.myqcloud.com
S3_REGION=ap-singapore
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_SESSION_TOKEN=
S3_USE_PATH_STYLE=false
MEDIA_PUBLIC_BASE_URL=https://media.yujian.me

# EdgeOne Pages Direct Upload project.
PAGES_API_TOKEN=
PAGES_PROJECT_ID=
PAGES_REGION=global
PAGES_PUBLIC_URL=https://yujian.me
